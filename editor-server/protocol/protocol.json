{
  "version": "1.0.0",
  "commands": {
    "RenderFrame": {
      "id": "0x01",
      "description": "Renders one frame at the viewport size (SetViewportSize; 1280x720 until it is called). pixels is width * height * 4 bytes of RGBA8, top row first, alpha 255, on every renderer backend, so it can be drawn as-is (e.g. as canvas ImageData).",
      "request": {},
      "response": {
        "type": "FrameData",
        "fields": {
          "width": "uint32",
          "height": "uint32",
          "pixels": "bytes"
        }
      }
    },
    "SetViewportSize": {
      "id": "0x02",
      "description": "Sets the size, in pixels, that later RenderFrame frames are rendered at (each 1 to 4096; anything else is an Error). The renderer itself is resized, so frames are neither cropped nor resampled, and the camera's aspect follows.",
      "request": {
        "width": "int32",
        "height": "int32"
      },
      "response": { "type": "Ok" }
    },
    "GetAudio": {
      "id": "0x03",
      "request": {},
      "response": {
        "type": "AudioSamples",
        "fields": {
          "sampleRate": "uint32",
          "channels": "uint32",
          "sampleFormat": "string",
          "frameCount": "uint32",
          "droppedFrames": "uint32",
          "samples": "bytes"
        }
      }
    },
    "SetCameraPosition": {
      "id": "0x10",
      "request": {
        "x": "float32",
        "y": "float32",
        "z": "float32"
      },
      "response": { "type": "Ok" }
    },
    "GetCameraPosition": {
      "id": "0x12",
      "request": {},
      "response": {
        "type": "CameraPosition",
        "fields": {
          "x": "float32",
          "y": "float32",
          "z": "float32"
        }
      }
    },
    "CreateScene": {
      "id": "0x20",
      "request": {
        "name": "string"
      },
      "response": {
        "type": "SceneData",
        "fields": {
          "sceneJson": "string"
        }
      }
    },
    "LoadScene": {
      "id": "0x21",
      "request": {
        "sceneJson": "string"
      },
      "response": { "type": "Ok" }
    },
    "SaveScene": {
      "id": "0x22",
      "request": {},
      "response": {
        "type": "SceneData",
        "fields": {
          "sceneJson": "string"
        }
      }
    },
    "DeleteScene": {
      "id": "0x23",
      "request": {
        "sceneName": "string"
      },
      "response": { "type": "Ok" }
    },
    "GetCurrentScene": {
      "id": "0x24",
      "request": {},
      "response": {
        "type": "SceneData",
        "fields": {
          "sceneJson": "string"
        }
      }
    },
    "CreateEntity": {
      "id": "0x30",
      "request": {
        "name": "string"
      },
      "response": {
        "type": "EntityCreated",
        "fields": {
          "entityId": "string"
        }
      }
    },
    "DestroyEntity": {
      "id": "0x31",
      "request": {
        "entityId": "string"
      },
      "response": { "type": "Ok" }
    },
    "SetEntityTransform": {
      "id": "0x32",
      "request": {
        "entityId": "string",
        "position": "vec3",
        "rotation": "vec3",
        "scale": "vec3"
      },
      "response": { "type": "Ok" }
    },
    "GetEntityTransform": {
      "id": "0x33",
      "request": {
        "entityId": "string"
      },
      "response": {
        "type": "EntityTransform",
        "fields": {
          "position": "vec3",
          "rotation": "vec3",
          "scale": "vec3"
        }
      }
    },
    "GetAllEntities": {
      "id": "0x34",
      "request": {},
      "response": {
        "type": "EntityList",
        "fields": {
          "count": "uint32",
          "entities": "EntityInfo[]"
        }
      }
    },
    "CreateScript": {
      "id": "0x40",
      "request": {
        "name": "string"
      },
      "response": {
        "type": "ScriptData",
        "fields": {
          "scriptTemplate": "string"
        }
      }
    },
    "RescanAssets": {
      "id": "0x41",
      "request": {},
      "response": { "type": "Ok" }
    },
    "GetEngineHealth": {
      "id": "0x50",
      "request": {},
      "response": {
        "type": "EngineHealth",
        "fields": {
          "healthy": "bool",
          "count": "uint32",
          "subsystems": "SubsystemStatus[]"
        }
      }
    },
    "Shutdown": {
      "id": "0xFF",
      "request": {},
      "response": { "type": "Ok" }
    }
  },
  "types": {
    "vec3": {
      "x": "float32",
      "y": "float32",
      "z": "float32"
    },
    "EntityInfo": {
      "id": "string",
      "name": "string"
    },
    "SubsystemStatus": {
      "name": "string",
      "state": "string",
      "detail": "string"
    }
  },
  "responses": {
    "Ok": "0x00",
    "Error": "0x01",
    "FrameData": "0x02",
    "CameraPosition": "0x03",
    "EntityTransform": "0x04",
    "EntityList": "0x05",
    "EntityCreated": "0x06",
    "SceneData": "0x07",
    "ScriptData": "0x08",
    "EngineHealth": "0x09",
    "AudioSamples": "0x0A"
  }
}