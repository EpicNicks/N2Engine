{ "n2shader": 1, "name": "InverseMat4" }
#stage fragment
// Probe row: inverse(mat4) and the engine's per-draw matrices (n2_Model * v means the same on every target)
void main() {
    mat4 inverseModel = inverse(n2_Model);
    vec4 local = inverseModel * vec4(n2_WorldPos, 1.0);
    vec4 clip = n2_Projection * n2_View * n2_Model * local;
    n2_FragColor = vec4(clip.xyz / max(abs(clip.w), 0.0001), 1.0);
}
