{ "n2shader": 1, "name": "Switch",
  "params": [ { "name": "u_Mode", "type": "int", "default": 1, "min": 0, "max": 3 } ]
}
#stage fragment
// Probe row: switch on an int
void main() {
    vec3 color = vec3(0.0);
    switch (u_Mode) {
        case 0: color = vec3(1.0, 0.0, 0.0); break;
        case 1: color = vec3(0.0, 1.0, 0.0); break;
        case 2: color = vec3(0.0, 0.0, 1.0); break;
        default: color = vec3(0.5);
    }
    n2_FragColor = vec4(color, 1.0);
}
