{ "n2shader": 1, "name": "UintHash" }
#stage fragment
// Probe row: uint bit operations and an integer hash
uint hash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

void main() {
    uvec2 cell = uvec2(n2_UV * 64.0);
    uint h = hash(cell.x + hash(cell.y)) & 0xffu;
    n2_FragColor = vec4(vec3(float(h) / 255.0), 1.0);
}
